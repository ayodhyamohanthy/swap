{
  "name": "seatswap",
  "private": true,
  "version": "0.1.0",
  "description": "SeatSwap \u2014 mobile-first PWA for train berth swaps (Build Plan steps 1-2: Foundation + Trips).",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace seatswap-app",
    "build": "npm run build --workspace seatswap-app",
    "preview": "npm run preview --workspace seatswap-app",
    "typecheck": "npm run typecheck --workspace seatswap-app",
    "test": "npm run test --workspace seatswap-app",
    "verify": "npm run verify --workspace seatswap-app",
    "collab-check": "npm run collab-check --workspace seatswap-app",
    "collab:install-hooks": "node app/scripts/install-hooks.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
