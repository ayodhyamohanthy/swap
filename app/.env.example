# Rename this file to .env.example in the repo (kept as env.example here
# so it is visible in every file browser).

# ── Client (VITE_ = readable by browser bundle; safe-ish, still don't commit real values)
# Supabase: paste SEATSWAP-STAGING's values, never prod's (docs/12 §4).
# Both live under Project Settings → API for the project whose ref is
# recorded in that table. collab-check refuses a committed URL whose
# project ref is not recorded there, and `node app/scripts/staging-dry-run.mjs`
# reports which project an agent is about to point at — run it before pasting.
VITE_SUPABASE_URL=            # Supabase → project settings → API (per env)
VITE_SUPABASE_ANON_KEY=       # same page; anon key ONLY, never service role
VITE_POSTHOG_KEY=             # PostHog org skipwait → project SeatSwap
VITE_POSTHOG_HOST=            # e.g. https://us.i.posthog.com
VITE_SENTRY_DSN=              # Sentry skipwait → project seatswap-web
VITE_RAZORPAY_KEY_ID=         # Razorpay dashboard (key id is public by design)

# ── Worker secrets (set via `wrangler secret put`, NEVER in client, NEVER VITE_)
# SUPABASE_SERVICE_ROLE_KEY   — Supabase (staging project's, by default); full
#                               DB access, treat like a root password
# SENTRY_DSN_WORKER           — Sentry project seatswap-worker
# RAZORPAY_KEY_SECRET         — Razorpay
# PAYPAL_CLIENT_ID / PAYPAL_SECRET — PayPal developer dashboard
# ZEPTOMAIL_TOKEN             — Zoho ZeptoMail

# Full var→vendor map: docs/12-INFRA-CREDITS.md §8. A var not in that
# table is a bug. Client bundles physically cannot read worker secrets.



