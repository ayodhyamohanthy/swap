# SeatSwap — npm settings
#
# legacy-peer-deps: the dependency tree here is pinned by hand and verified
# (React 19 + Vite 7 + TanStack Start v1 + Tailwind v4 + vite-plugin-pwa).
# npm 10 hits a known arborist bug ("Cannot read properties of null (reading
# 'edgesOut')") while resolving the many exact-version optional peers that
# vitest 4 declares. Installing with this flag keeps `npm install` working on a
# clean machine. Nothing here relaxes a real compatibility requirement.
legacy-peer-deps=true
fund=false
audit=false
